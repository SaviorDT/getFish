<Window x:Class="撈金魚.UserInterface.UpdateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:撈金魚.UserInterface"
        mc:Ignorable="d"
        Title="更新設定" Height="260" Width="300"
        Closing="ClosingAction">
    <Grid>
        <CheckBox x:Name="auto_update" Content="自動更新" HorizontalAlignment="Left" Margin="25,25,0,0" VerticalAlignment="Top" Checked="AutoUpdateChanged" Unchecked="AutoUpdateChanged"/>
        <TextBlock x:Name="current_version_text" HorizontalAlignment="Left" Margin="25,60,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="status_text" HorizontalAlignment="Left" Margin="25,90,0,0" VerticalAlignment="Top" Width="250" TextWrapping="Wrap"/>
        <Button Content="手動檢查更新" HorizontalAlignment="Left" Margin="25,130,0,0" VerticalAlignment="Top" Height="28" Width="100" Click="CheckUpdateButtonClick"/>
        <StackPanel x:Name="update_choice_panel" Orientation="Horizontal" HorizontalAlignment="Left" Margin="25,170,0,0" VerticalAlignment="Top" Visibility="Collapsed">
            <Button Content="立即更新" Width="70" Height="28" Click="UpdateNowButtonClick" Margin="0,0,5,0"/>
            <Button Content="關閉時更新" Width="80" Height="28" Click="UpdateOnCloseButtonClick" Margin="0,0,5,0"/>
            <Button Content="暫不更新" Width="70" Height="28" Click="SkipUpdateButtonClick"/>
        </StackPanel>
    </Grid>
</Window>
